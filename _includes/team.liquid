{% assign order = "phd_current|ra_current|alumni_hkustgz|alumni_szu" | split: "|" %}
{% assign labels = "PhD Students @ HKUST (GZ)|Research Assistants @ HKUST (GZ)|Alumni of MobiX @ HKUST (GZ)|Alumni of BDUC @ Shenzhen University" | split: "|" %}
{% assign all = site.data.members.members %}
{% for g in order %}
{% assign subset = all | where: "group", g %}
{% if subset.size > 0 %}
<h2 style="font-size:1.35rem;font-weight:600;margin:2rem 0 1rem;padding-bottom:.4rem;border-bottom:1px solid #e3e3e3;">{{ labels[forloop.index0] }} <span style="font-weight:400;color:#888;font-size:.9rem;">({{ subset.size }})</span></h2>
<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:16px;">
{% for m in subset %}
<div style="border:1px solid #e5e5e5;border-radius:10px;padding:14px 10px;text-align:center;background:#fff;">
<img src="{{ m.photo | relative_url }}" alt="{{ m.name_en }}" loading="lazy" style="width:110px;height:145px;object-fit:cover;border-radius:6px;">
<div style="font-weight:600;margin-top:10px;font-size:14px;">{{ m.name_en }}</div>
<div style="color:#666;font-size:13px;">{{ m.name_zh }}</div>
<div style="color:#777;font-size:12px;margin-top:6px;">{{ m.period }}</div>
{% if m.degree_from != "" %}
<div style="color:#777;font-size:12px;margin-top:3px;">{{ m.degree_from }}</div>
{% endif %}
{% if m.topics.size > 0 %}
<div style="font-size:12px;margin-top:5px;">{{ m.topics | join: ", " }}</div>
{% endif %}
{% if m.next != "" %}
<div style="font-size:12px;margin-top:7px;color:#0a6a4a;"><b>Next:</b> {{ m.next }}</div>
{% endif %}
{% if m.awards.size > 0 %}
<div style="font-size:11px;margin-top:5px;color:#8a5a00;">Award: {{ m.awards | join: "; " }}</div>
{% endif %}
{% if m.pubs.size > 0 %}
<div style="font-size:11px;margin-top:3px;color:#888;">{{ m.pubs | join: ", " }}</div>
{% endif %}
</div>
{% endfor %}
</div>
{% endif %}
{% endfor %}
