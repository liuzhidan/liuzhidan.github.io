<style type="text/css">
/* Member-card styling, kept in one <style> block so dark-mode overrides can
   sit next to the light rules instead of being scattered across inline styles.
   The BDUC alumni list is long, so it uses a fixed 6-up grid instead of auto-fill;
   sizes are tightened for it via the .team-alumni-grid context. */
.team-group-title{font-size:1.35rem;font-weight:600;margin:2rem 0 1rem;padding-bottom:.4rem;border-bottom:1px solid #e3e3e3}
.team-group-count{font-weight:400;color:#888;font-size:.9rem}
.team-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:16px}
.team-card{border:1px solid #e5e5e5;border-radius:10px;padding:14px 10px;text-align:center;background:#fff}
.team-alumni-grid .team-card{padding:10px 6px}
.team-alumni-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:10px}
@media (max-width:1140px){.team-alumni-grid{grid-template-columns:repeat(4,1fr)}}
@media (max-width:820px){.team-alumni-grid{grid-template-columns:repeat(3,1fr)}}
@media (max-width:560px){.team-alumni-grid{grid-template-columns:repeat(2,1fr)}}
.team-photo{width:110px;height:145px;object-fit:cover;border-radius:6px}
.team-alumni-grid .team-photo{width:84px;height:112px}
.team-name-en{font-weight:600;margin-top:10px;font-size:14px}
.team-alumni-grid .team-name-en{font-size:13px}
.team-name-zh{color:#8c8c8c;font-size:11px;margin-top:1px}
.team-period{color:#777;font-size:12px;margin-top:6px}
.team-alumni-grid .team-period{font-size:11px;margin-top:4px}
.team-from{color:#777;font-size:12px;margin-top:3px}
.team-topics{font-size:12px;margin-top:5px}
.team-awards{font-size:11px;margin-top:5px;color:#8a6a1a;line-height:1.35}
.team-alumni-grid .team-awards{font-size:10px}
.team-pubs{font-size:11px;margin-top:3px;color:#888}
.team-next{font-size:12px;margin-top:7px;color:#0a6a4a}
.team-alumni-grid .team-next{font-size:11px;margin-top:6px}
/* MPhil / MSc badge; the two share the Master Students group */
.team-degree{display:inline-block;font-size:.6rem;font-weight:700;letter-spacing:.06em;padding:.06rem .35rem;margin-right:.35rem;border-radius:3px;background:#eef1f5;color:#3c5a78;border:1px solid #dde3ea}
/* hero image and the hiring banner on the Team page */
.team-hero{max-width:100%;height:auto;border-radius:10px}
.team-hiring{background:#fff4f4;border-left:4px solid #d9534f;padding:12px 16px;border-radius:6px;margin:1.5rem 0}

/* al-folio switches themes with html[data-theme=dark] (JS + the toggle button),
   NOT with prefers-color-scheme. */
html[data-theme=dark] .team-group-title{border-bottom-color:#3a3a3a}
html[data-theme=dark] .team-group-count{color:#9aa0a6}
html[data-theme=dark] .team-card{background:#1e2124;border-color:#3a3f45}
html[data-theme=dark] .team-name-en{color:#e8eaed}
html[data-theme=dark] .team-name-zh{color:#9aa0a6}
html[data-theme=dark] .team-period{color:#9aa0a6}
html[data-theme=dark] .team-from{color:#9aa0a6}
html[data-theme=dark] .team-topics{color:#cdd3dc}
html[data-theme=dark] .team-awards{color:#d4a857}
html[data-theme=dark] .team-pubs{color:#8a8f96}
html[data-theme=dark] .team-next{color:#5fc98f}
html[data-theme=dark] .team-degree{background:#2a2e33;color:#9ab8d8;border-color:#3a3f45}
html[data-theme=dark] .team-hiring{background:#3a2626;border-left-color:#e57373;color:#e8d9d9}
html[data-theme=dark] .team-hero{box-shadow:0 0 0 1px #3a3f45}
</style>
{% assign order = "phd_current|master_current|ra_current|ug_current|alumni_hkustgz|alumni_szu" | split: "|" %}
{% assign labels = "PhD Students @ HKUST (GZ)|Master Students @ HKUST (GZ)|Research Assistants @ HKUST (GZ)|Undergraduate Researchers|Alumni of MobiX @ HKUST (GZ)|Alumni of BDUC @ Shenzhen University" | split: "|" %}
{% assign all = site.data.members.members %}
{% for g in order %}
{% assign subset = all | where: "group", g %}
{% assign compact = false %}
{% if g == "alumni_szu" %}
{% assign compact = true %}
{% endif %}
{% if subset.size > 0 %}
<h2 class="team-group-title">{{ labels[forloop.index0] }} <span class="team-group-count">({{ subset.size }})</span></h2>
{% if compact %}
<div class="team-alumni-grid">
{% else %}
<div class="team-grid">
{% endif %}
{% for m in subset %}
<div class="team-card">
<img src="{{ m.photo | relative_url }}" alt="{{ m.name_en }}" loading="lazy" class="team-photo">
<div class="team-name-en">{{ m.name_en }}</div>
{% if m.name_zh != blank %}
<div class="team-name-zh">{{ m.name_zh }}</div>
{% endif %}
<div class="team-period">
{%- if m.degree != blank -%}
<span class="team-degree">{{ m.degree }}</span>
{%- endif -%}
{{- m.period -}}
</div>
{% unless compact %}
{% if m.degree_from != blank %}
<div class="team-from">{{ m.degree_from }}</div>
{% endif %}
{% if m.topics.size > 0 %}
<div class="team-topics">{{ m.topics | join: ", " }}</div>
{% endif %}
{% endunless %}
{% if m.awards.size > 0 %}
<div class="team-awards">★ {{ m.awards | join: "; " }}</div>
{% endif %}
{% unless compact %}
{% if m.pubs.size > 0 %}
<div class="team-pubs">{{ m.pubs | join: ", " }}</div>
{% endif %}
{% endunless %}
{% if m.next != blank %}
{% if compact %}
<div class="team-next">{{ m.next }}</div>
{% else %}
<div class="team-next"><b>Next:</b> {{ m.next }}</div>
{% endif %}
{% endif %}
</div>
{% endfor %}
</div>
{% endif %}
{% endfor %}
